{
  "_version": "216.5",
  "_comment": "Phase 216.5 — WORKSPACE-SCOPED MCP CONFIG. Broadcast stamps this + _version to every fleet workspace.",
  "_comment2": "Servers here: gcloud + chrome-devtools + context7 ONLY. The 3 global servers (firebase, knowledge-graph, brave-search) are registered in ~/.gemini/mcp_config.json and do NOT need to be repeated here.",
  "_comment3": "This prevents the N-tab process multiplication: each workspace window adds only gcloud + chrome + context7 (3 processes), not 5.",
  "_hang_note": "CI=true on gcloud prevents interactive gcloud auth prompts that block stdio in non-TTY MCP processes.",
  "mcpServers": {
    "gcloud": {
      "command": "/opt/homebrew/Cellar/node@22/22.22.0/bin/node",
      "args": [
        "/Users/teknojunkeee/.gemini/mcp-deps/node_modules/.bin/gcloud-mcp"
      ],
      "env": {
        "PATH": "/opt/homebrew/Cellar/node@22/22.22.0/bin:/opt/homebrew/share/google-cloud-sdk/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
        "NODE_OPTIONS": "--max-old-space-size=4096",
        "UV_THREADPOOL_SIZE": "32",
        "CI": "true"
      }
    },
    "chrome-devtools": {
      "command": "/opt/homebrew/Cellar/node@22/22.22.0/bin/node",
      "args": [
        "/Users/teknojunkeee/.gemini/mcp-deps/node_modules/.bin/chrome-devtools-mcp"
      ],
      "env": {
        "PATH": "/opt/homebrew/Cellar/node@22/22.22.0/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
        "NODE_OPTIONS": "--max-old-space-size=4096",
        "UV_THREADPOOL_SIZE": "32"
      }
    },
    "context7": {
      "command": "/opt/homebrew/Cellar/node@22/22.22.0/bin/node",
      "args": [
        "/Users/teknojunkeee/.gemini/mcp-deps/node_modules/.bin/context7-mcp"
      ],
      "env": {
        "PATH": "/opt/homebrew/Cellar/node@22/22.22.0/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin",
        "NODE_OPTIONS": "--max-old-space-size=4096"
      }
    }
  }
}
