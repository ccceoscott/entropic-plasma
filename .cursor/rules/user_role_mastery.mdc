## 3. CLIENT — READING ROLES SAFELY

```typescript
// ✅ Type-safe claims hook
export function useUserRoles() {
  const { user } = useAuth();
  const [claims, setClaims] = useState<Record<string, boolean>>({});

  useEffect(() => {
    user?.getIdTokenResult().then(({ claims }) => {
      setClaims(claims as Record<string, boolean>);
    });
  }, [user]);

  return {
    isAdmin: claims.admin === true || claims.superAdmin === true,
    isVendor: claims.vendor === true,
    isDistributor: claims.distributor === true,
    isAffiliate: claims.affiliate === true,
    isFulfillment: claims.fulfillment === true,
    isSupport: claims.support === true,
    isCustomer: claims.customer === true,
    isWholesalePending: claims.wholesale_pending === true,
    isWholesaleApproved: claims.wholesale_approved === true,
  };
}

// ✅ Portal & Storefront Cloning Context
// Use PortalContext to inject branding and custom pricing tiers based on active RBAC roles.
// Example: wholesale_approved users see different CSS variables and un-gated wholesale catalogs.
```

