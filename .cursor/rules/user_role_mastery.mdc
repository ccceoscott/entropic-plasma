## 4. NEXT.JS MIDDLEWARE ENFORCEMENT

```typescript
// middleware.ts — runs at edge before every request
import { NextResponse } from 'next/server';
import type { NextRequest } from 'next/server';

const ROLE_ROUTES: Record<string, string[]> = {
  '/admin':       ['admin', 'superAdmin'],
  '/vendor':      ['vendor', 'superAdmin'],
  '/distributor': ['distributor', 'superAdmin'],
  '/fulfillment': ['fulfillment', 'admin', 'superAdmin'],
  '/support':     ['support', 'admin', 'superAdmin'],
};

export async function middleware(request: NextRequest) {
  const token = request.cookies.get('__session')?.value;
  if (!token) return NextResponse.redirect(new URL('/login', request.url));

  // Verify token server-side via Firebase Admin (callable from edge with service account)
  const claims = await verifySessionCookie(token); // your helper
  const path = Object.keys(ROLE_ROUTES).find(r => request.nextUrl.pathname.startsWith(r));

  if (path) {
    const allowed = ROLE_ROUTES[path];
    const hasRole = allowed.some(role => claims?.[role] === true);
    if (!hasRole) return NextResponse.redirect(new URL('/unauthorized', request.url));
  }

  return NextResponse.next();
}

export const config = {
  matcher: ['/admin/:path*', '/vendor/:path*', '/distributor/:path*', '/fulfillment/:path*', '/support/:path*'],
};
```

