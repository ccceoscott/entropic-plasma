## 5. FIRESTORE SECURITY RULES — Role-Gated Writes

```javascript
// firestore.rules
rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // Helper functions — read claims from token
    function isAuth()        { return request.auth != null; }
    function isSuperAdmin()  { return isAuth() && request.auth.token.superAdmin == true; }
    function isAdmin()       { return isAuth() && (request.auth.token.admin == true || isSuperAdmin()); }
    function isVendor()      { return isAuth() && request.auth.token.vendor == true; }
    function isSupport()     { return isAuth() && request.auth.token.support == true; }
    function isFulfillment() { return isAuth() && request.auth.token.fulfillment == true; }
    function isOwner(uid)    { return isAuth() && request.auth.uid == uid; }

    // Orders — customer reads own, admin reads all, fulfillment updates status only
    match /orders/{orderId} {
      allow read:   if isOwner(resource.data.customerId) || isAdmin() || isSupport() || isFulfillment();
      allow create: if isAuth();
      allow update: if isAdmin()
        || (isFulfillment() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'metadata.updatedAt']));
      allow delete: if false; // Soft delete only
    }

    // Products — vendor manages own, admin manages all, public reads
    match /products/{productId} {
      allow read:   if true;
      allow create: if isAdmin() || (isVendor() && request.resource.data.vendorId == request.auth.uid);
      allow update: if isAdmin() || (isVendor() && resource.data.vendorId == request.auth.uid);
      allow delete: if false;
    }

    // Users — own profile or admin
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin() || isSupport();
      allow write:  if isOwner(userId) || isAdmin();
      allow delete: if false;
    }
  }
}
```

