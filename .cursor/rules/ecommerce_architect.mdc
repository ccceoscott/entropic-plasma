```typescript
// ✅ Tier-Based Discount Logic
export const calculateDiscount = (subtotal: number, coupon: any, userRole: string) => {
  if (userRole === 'wholesale_approved') return subtotal * 0.6; // Flat 40% B2B
  if (coupon.type === 'percentage') return subtotal * (1 - coupon.value / 100);
  if (coupon.type === 'fixed') return Math.max(0, subtotal - coupon.value);
  return subtotal;
};
```

