## LAW 4: IDEMPOTENCY PROTOCOL

### The Rule
- ALWAYS use `batch.set(ref, data, { merge: true })` — NEVER `batch.set(ref, data)` (clobbers all existing fields).
- ALWAYS write a version record to `_seedMeta/{collectionName}` upon success.
- Scripts SHOULD check the `_seedMeta` version before running and skip if version matches (unless `--force` flag).
- Deprecated/stale document IDs MUST be explicitly `batch.delete()`'d — not ignored.

### Canonical Pattern (REQUIRED)
```typescript
const SEED_VERSION = 'v1.3.0'; // Bump this when changing the product catalog

async function run() {
    // 1. Check version guard (skip if already at this version, unless --force)
    const isForce = process.argv.includes('--force');
    const metaRef = db.collection('_seedMeta').doc('products');
    const metaSnap = await metaRef.get();

    if (!isForce && metaSnap.exists && metaSnap.data()?.version === SEED_VERSION) {
        console.log(`✅ Firestore already at seed version ${SEED_VERSION}. Pass --force to re-seed.`);
        process.exit(0);
    }

    // 2. Chunk batches at 499 ops max (Firestore limit is 500)
    const CHUNK_SIZE = 499;
    const chunks = [];
    for (let i = 0; i < validated.length; i += CHUNK_SIZE) {
        chunks.push(validated.slice(i, i + CHUNK_SIZE));
    }

    for (const chunk of chunks) {
        const batch = db.batch();
        for (const product of chunk) {
            const ref = db.collection('products').doc(product.id);
            batch.set(ref, {
                ...product,
                updatedAt: admin.firestore.FieldValue.serverTimestamp(),
            }, { merge: true }); // merge: true is LAW
        }

        // 3. Delete deprecated docs in same batch
        for (const depId of DEPRECATED_IDS) {
            batch.delete(db.collection('products').doc(depId));
        }

        await batch.commit();
    }

    // 4. Write seed meta checkpoint
    await metaRef.set({ version: SEED_VERSION, seededAt: admin.firestore.FieldValue.serverTimestamp() });
    console.log(`✅ Seeded ${validated.length} docs. Version checkpoint: ${SEED_VERSION}`);
}
```

