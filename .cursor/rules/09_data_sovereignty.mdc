## LAW 6: FIREBASE CONNECTION VERIFICATION

### The Rule
- All apps MUST have a `src/lib/firebase.ts` that performs a **connection health check** on startup in development mode.
- The health check MUST log a clear warning if `FIREBASE_CONFIG` env vars are missing.
- Apps MUST NOT silently continue with an un-initialized Firebase instance.

### Canonical Pattern (REQUIRED)
```typescript
// src/lib/firebase.ts
import { initializeApp, getApps } from 'firebase/app';
import { getFirestore, connectFirestoreEmulator } from 'firebase/firestore';

const firebaseConfig = {
    apiKey: import.meta.env.VITE_FIREBASE_API_KEY,
    authDomain: import.meta.env.VITE_FIREBASE_AUTH_DOMAIN,
    projectId: import.meta.env.VITE_FIREBASE_PROJECT_ID,
    // ...
};

// ✅ Guard against missing config in development
if (import.meta.env.DEV) {
    const requiredKeys = ['VITE_FIREBASE_API_KEY', 'VITE_FIREBASE_AUTH_DOMAIN', 'VITE_FIREBASE_PROJECT_ID'];
    const missing = requiredKeys.filter(k => !import.meta.env[k]);
    if (missing.length > 0) {
        throw new Error(`[Firebase] Missing required env vars: ${missing.join(', ')}. Check .env.local`);
    }
}

const app = getApps().length ? getApps()[0] : initializeApp(firebaseConfig);
export const db = getFirestore(app);

// ✅ Connect to emulator in development if specified
if (import.meta.env.DEV && import.meta.env.VITE_USE_EMULATOR === 'true') {
    connectFirestoreEmulator(db, 'localhost', 8080);
    console.info('[Firebase] Connected to Firestore emulator at localhost:8080');
}
```

