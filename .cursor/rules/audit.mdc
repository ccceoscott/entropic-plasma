## 1. LIVE CONSOLE AUDIT (LCA) - Playwright execution
An audit MUST programmatically spawn a browser, traverse the core application paths, and throw hard errors if console warnings or hydration errors occur.

```typescript
// ✅ REQUIRED PATTERN: tests/e2e/infinity_compliance.spec.ts
import { test, expect } from '@playwright/test';

test('Live Console Audit (LCA) encounters zero hydration or console errors', async ({ page }) => {
  const errors: string[] = [];
  page.on('console', msg => {
    if (msg.type() === 'error') errors.push(msg.text());
  });
  page.on('pageerror', exception => {
    errors.push(exception.message);
  });

  await page.goto('/');
  await page.waitForLoadState('networkidle');

  // Verify Identity Handshake / Liquid Glass Fidelity
  await expect(page.locator('body')).toHaveClass(/bg-black/);
  
  // Hard failure if ANY console logic broke
  expect(errors).toHaveLength(0);
});
```

